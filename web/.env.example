# Copy this file to .env and fill in your Supabase project details.
# The anon key is safe to use in the browser. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the FastAPI server runs (default shown)
VITE_API_URL=http://127.0.0.1:8000

# Optional: serve the hand model locally for offline demos
# VITE_HAND_MODEL_URL=/mediapipe/hand_landmarker.task